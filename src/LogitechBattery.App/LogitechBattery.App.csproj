<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>LogitechBattery</RootNamespace>
    <AssemblyName>LogitechBattery</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Uncompressed: a compressed exe is unpacked into private memory at start (52 MB in Task Manager); an uncompressed one is mapped
      from the file (12 MB). Measured on Windows 2026-11-08, together with the two settings below. The exe is about 107 MB instead of 52 MB.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- The UI is English only; this drops the 13 WinForms language folders (MessageBox buttons stay localized by Windows). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- All formatting in the code uses InvariantCulture, so the app does not need the ICU culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogitechBattery.Core\LogitechBattery.Core.csproj" />
  </ItemGroup>

</Project>
